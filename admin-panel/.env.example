ADMIN_USERNAME=your_username
ADMIN_PASSWORD_HASH=your_bcrypt_hash
SESSION_SECRET=your_session_secret

# Email Client Configuration (Stored securely, never committed to git)
EMAIL_USER=contact@ghufran.net
EMAIL_PASS=your_secure_mailbox_password

# IMAP Server Settings (To read received emails)
IMAP_HOST=mail.ghufran.net
IMAP_PORT=993
IMAP_SECURE=true

# SMTP Server Settings (To send outgoing emails)
SMTP_HOST=mail.ghufran.net
SMTP_PORT=587
SMTP_SECURE=true

# Security Configurations
CSRF_SECRET=your_random_csrf_secret_key
