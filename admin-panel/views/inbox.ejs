    function setupAutocomplete(inputId, dropdownId) {
      const input = document.getElementById(inputId);
      const dropdown = document.getElementById(dropdownId);
      if (!input || !dropdown) return;
      
      let highlightIdx = 0;

      input.addEventListener('input', async function() {
        const value = this.value;
        const segments = value.split(',');
        const currentSegment = segments[segments.length - 1].trim();
        
        if (currentSegment.length < 1) {
          dropdown.style.display = 'none';
          return;
        }
        
        try {
          const response = await fetch(`/admin/api/contacts/autocomplete?q=${encodeURIComponent(currentSegment)}`);
          const result = await response.json();
          
          if (result.success && result.data.length > 0) {
            dropdown.innerHTML = '';
            dropdown.style.display = 'block';
            highlightIdx = 0;
            
            result.data.forEach((contact, idx) => {
              const item = document.createElement('div');
              item.className = 'autocomplete-item' + (idx === 0 ? ' highlighted' : '');
              item.setAttribute('role', 'option');
              item.innerHTML = `
                <div class="autocomplete-avatar">${contact.avatar_initials}</div>
                <div class="autocomplete-info">
                  <span class="autocomplete-name">${contact.name}</span>
                  <span class="autocomplete-email">${contact.email}</span>
                </div>
              `;
              item.onclick = () => {
                segments[segments.length - 1] = ` "${contact.name}" <${contact.email}>`;
                input.value = segments.join(', ') + ', ';
                dropdown.style.display = 'none';
                input.focus();
              };
              dropdown.appendChild(item);
            });
          } else {
            dropdown.style.display = 'none';
          }
        } catch (err) {
          console.error(err);
        }
      });

      input.addEventListener('keydown', function(e) {
        const items = dropdown.querySelectorAll('.autocomplete-item');
        if (dropdown.style.display === 'block' && items.length > 0) {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            items[highlightIdx].classList.remove('highlighted');
            highlightIdx = (highlightIdx + 1) % items.length;
            items[highlightIdx].classList.add('highlighted');
            items[highlightIdx].scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            items[highlightIdx].classList.remove('highlighted');
            highlightIdx = (highlightIdx - 1 + items.length) % items.length;
            items[highlightIdx].classList.add('highlighted');
            items[highlightIdx].scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'Enter') {
            e.preventDefault();
            items[highlightIdx].click();
          } else if (e.key === 'Escape') {
            e.stopPropagation(); // Avoid closing composer
            dropdown.style.display = 'none';
          }
        }
      });

      document.addEventListener('click', (e) => {
        if (e.target !== input && e.target !== dropdown) {
          dropdown.style.display = 'none';
        }
      });
    }

    setupAutocomplete('comp-to', 'comp-to-autocomplete');
    setupAutocomplete('comp-cc', 'comp-cc-autocomplete');
    setupAutocomplete('comp-bcc', 'comp-bcc-autocomplete');

    // --- GLOBAL MODAL ESCAPE LISTENER ---
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const composer = document.getElementById('composer-card');
        if (composer && composer.style.display === 'flex') {
          // Double-check no autocomplete lists are currently active
          const listTo = document.getElementById('comp-to-autocomplete');
          const listCc = document.getElementById('comp-cc-autocomplete');
          const listBcc = document.getElementById('comp-bcc-autocomplete');
          
          if ((listTo && listTo.style.display === 'block') ||
              (listCc && listCc.style.display === 'block') ||
              (listBcc && listBcc.style.display === 'block')) {
            return;
          }
          closeCompose(true);
        }
      }
    });

    // --- KEYBOARD NAVIGATION (Up/Down Arrow keys for Email List) ---
    document.addEventListener('keydown', function(e) {
      // Bypassed if shortcuts are disabled in user preferences
      if (!shortcutsEnabled) return;

      if (document.activeElement && 
         (document.activeElement.tagName === 'INPUT' || 
          document.activeElement.tagName === 'TEXTAREA' ||
          document.activeElement.getAttribute('contenteditable') === 'true')) {
        return;
      }

      if (['ArrowDown', 'ArrowUp'].includes(e.key)) {
        const rowClass = activeFolder === 'contacts' ? '.contact-item-row' : '.email-item-row';
        const activeRow = document.querySelector(rowClass + '.selected');
        const rows = Array.from(document.querySelectorAll(rowClass));
        if (rows.length === 0) return;

        let targetIndex = 0;
        if (activeRow) {
          const currentIndex = rows.indexOf(activeRow);
          if (e.key === 'ArrowDown') {
            targetIndex = Math.min(currentIndex + 1, rows.length - 1);
          } else {
            targetIndex = Math.max(currentIndex - 1, 0);
          }
        }
        
        e.preventDefault();
        rows[targetIndex].click();
        rows[targetIndex].scrollIntoView({ block: 'nearest' });
      }
    });
  </script>

</body>
</html>