        if (result.success) {
          triggerReload();
        } else {
          alert('Error saving contact: ' + result.message);
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Card';
          }
        }
      } catch (err) {
        console.error(err);
        alert('Network error saving contact details.');
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Card';
        }
      }
    }

