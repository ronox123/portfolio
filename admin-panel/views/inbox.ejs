          document.getElementById('email-view-empty').style.display = 'flex';
          activeEmailUid = null;
          activeEmailData = null;
        } else {
          showToast('Failed to archive: ' + result.message, true);
        }
      } catch (err) {
        showToast('Network error while archiving message.', true);
      }
    }

