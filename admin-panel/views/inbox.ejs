    function viewContact(id) {
      const contentPane = document.getElementById('email-view-content');
      document.getElementById('email-view-empty').style.display = 'none';
      contentPane.style.display = 'flex';
      
      contentPane.innerHTML = `
        <div style="padding:20px;">
          <div class="skeleton-header"></div>
          <div class="skeleton-meta"></div>
        </div>
      `;

      fetch(`/admin/api/contacts/${id}`)
        .then(res => res.json())
        .then(result => {
          if (result.success) {
            const contact = result.data;
            contentPane.innerHTML = `
              <div class="email-view-toolbar">
                <button class="btn btn-outline" onclick="openCompose({to: '${contact.email}'})" style="padding:6px 12px; font-size:11px; display:flex; align-items:center; gap:4px;">Send Email</button>
                <div style="display:flex; gap:6px;">
                  <button class="btn btn-solid-navy" onclick="editContact('${contact.id}')" style="padding:6px 12px; font-size:11px;">Edit Contact</button>
                  <button class="btn btn-danger-outline" onclick="deleteContact('${contact.id}')" style="padding:6px 12px; font-size:11px;">Delete</button>
                </div>
              </div>
              <div style="padding:24px; display:flex; flex-direction:column; gap:16px;">
                <div style="display:flex; align-items:center; gap:16px;">
                  <div class="avatar-wrapper" style="width: 64px; height: 64px; font-size: 24px; background-color: ${contact.favorite ? '#F59E0B' : '#4F46E5'}">
                    ${contact.avatar_initials}
                  </div>
                  <div>
                    <h2 style="font-size:20px; font-weight:700; color:var(--text-main); margin:0;">
                      ${contact.name}
                      <span style="color:#F59E0B; cursor:pointer;" onclick="toggleContactFavorite('${contact.id}')">${contact.favorite ? '★' : '☆'}</span>
                    </h2>
                    <p style="color:var(--text-muted); font-size:13px; margin-top:2px;">${contact.job_title || 'Contact'} ${contact.company ? 'at ' + contact.company : ''}</p>
                  </div>
                </div>
                
                <div style="border-top: 1px solid var(--border-color); padding-top:16px; display:flex; flex-direction:column; gap:12px; font-size:13px;">
                  <div>
                    <strong style="color:var(--text-muted); display:block; font-size:11px; text-transform:uppercase;">Primary Email</strong>
                    <span style="font-size:14px; font-weight:500;">${contact.email}</span>
                  </div>
                  ${contact.additional_emails ? `
                    <div>
                      <strong style="color:var(--text-muted); display:block; font-size:11px; text-transform:uppercase;">Alternative Emails</strong>
                      <span>${contact.additional_emails}</span>
                    </div>
                  ` : ''}
                  ${contact.phone ? `
                    <div>
                      <strong style="color:var(--text-muted); display:block; font-size:11px; text-transform:uppercase;">Phone Number</strong>
                      <span>${contact.phone}</span>
                    </div>
                  ` : ''}
                  ${contact.notes ? `
                    <div>
                      <strong style="color:var(--text-muted); display:block; font-size:11px; text-transform:uppercase;">Notes & Details</strong>
                      <p style="margin-top:4px; font-style:italic; background:#F8FAFC; padding:10px; border-radius:6px; border:1px solid #E2E8F0;">${contact.notes}</p>
                    </div>
                  ` : ''}
                </div>
              </div>
            `;
          }
        });
    }

    function openContactForm(contact = null) {
      const contentPane = document.getElementById('email-view-content');
      document.getElementById('email-view-empty').style.display = 'none';
      contentPane.style.display = 'flex';
      
      contentPane.innerHTML = `
        <div class="email-view-toolbar">
          <span style="font-weight:700; font-size:13px; color:var(--text-main);">${contact ? 'Edit Contact' : 'Create Contact Profile'}</span>
          <button class="btn btn-outline" onclick="document.getElementById('email-view-content').style.display='none'; document.getElementById('email-view-empty').style.display='flex';" style="padding:6px 12px; font-size:11px;">Cancel</button>
        </div>
        <form id="contact-edit-form" style="padding:24px; display:flex; flex-direction:column; gap:14px; overflow-y:auto;" onsubmit="saveContactForm(event, ${contact ? contact.id : 'null'})">
          <div>
            <label class="contact-form-label" style="display:block; font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">Full Name *</label>
            <input type="text" id="form-name" class="composer-input" style="border:1px solid var(--border-color); padding:8px 12px; border-radius:6px; background:#FCFDFE;" value="${contact ? contact.name : ''}" required>
          </div>
          <div>
            <label class="contact-form-label" style="display:block; font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">Primary Email *</label>
            <input type="email" id="form-email" class="composer-input" style="border:1px solid var(--border-color); padding:8px 12px; border-radius:6px; background:#FCFDFE;" value="${contact ? contact.email : ''}" required>
          </div>
          <div>
            <label class="contact-form-label" style="display:block; font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">Alternative Emails (comma separated)</label>
            <input type="text" id="form-additional" class="composer-input" style="border:1px solid var(--border-color); padding:8px 12px; border-radius:6px; background:#FCFDFE;" value="${contact ? contact.additional_emails || '' : ''}">
          </div>
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
            <div>
              <label class="contact-form-label" style="display:block; font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">Company</label>
              <input type="text" id="form-company" class="composer-input" style="border:1px solid var(--border-color); padding:8px 12px; border-radius:6px; background:#FCFDFE;" value="${contact ? contact.company || '' : ''}">
            </div>
            <div>
              <label class="contact-form-label" style="display:block; font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">Job Title</label>
              <input type="text" id="form-job" class="composer-input" style="border:1px solid var(--border-color); padding:8px 12px; border-radius:6px; background:#FCFDFE;" value="${contact ? contact.job_title || '' : ''}">
            </div>
          </div>
          <div>
            <label class="contact-form-label" style="display:block; font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">Phone Number</label>
            <input type="text" id="form-phone" class="composer-input" style="border:1px solid var(--border-color); padding:8px 12px; border-radius:6px; background:#FCFDFE;" value="${contact ? contact.phone || '' : ''}">
          </div>
          <div>
            <label class="contact-form-label" style="display:block; font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">Notes</label>
            <textarea id="form-notes" class="composer-input" style="border:1px solid var(--border-color); padding:8px 12px; border-radius:6px; background:#FCFDFE; height:80px; resize:vertical;">${contact ? contact.notes || '' : ''}</textarea>
          </div>
          <button type="submit" class="btn btn-solid-navy" id="contact-save-btn" style="width:100%; margin-top:10px; padding:10px;">Save Contact</button>
        </form>
      `;

      document.getElementById('form-name').focus();
    }

    async function saveContactForm(e, id) {
      e.preventDefault();
      const saveBtn = document.getElementById('contact-save-btn');
      saveBtn.textContent = 'Saving...';
      saveBtn.disabled = true;

      const payload = {
        name: document.getElementById('form-name').value,
        email: document.getElementById('form-email').value,
        additional_emails: document.getElementById('form-additional').value,
        company: document.getElementById('form-company').value,
        job_title: document.getElementById('form-job').value,
        phone: document.getElementById('form-phone').value,
        notes: document.getElementById('form-notes').value
      };

      const url = id ? `/admin/api/contacts/${id}` : '/admin/api/contacts';
      const method = id ? 'PUT' : 'POST';

      try {
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': document.getElementById('csrf-token-val').value
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();
        if (result.success) {
          showToast('Contact profile saved successfully!');
          triggerReload();
        } else {
          showToast('Failed to save contact: ' + result.message, true);
          saveBtn.textContent = 'Save Contact';
          saveBtn.disabled = false;
        }
      } catch (err) {
        showToast('Network error while saving contact.', true);
        saveBtn.textContent = 'Save Contact';
        saveBtn.disabled = false;
      }
    }

    function editContact(id) {
      fetch(`/admin/api/contacts/${id}`)
        .then(res => res.json())
        .then(result => {
          if (result.success) {
            openContactForm(result.data);
          }
        });
    }

    async function deleteContact(id) {
      if (confirm('Are you sure you want to delete this contact?')) {
        try {
          const response = await fetch(`/admin/api/contacts/${id}`, {
            method: 'DELETE',
            headers: {
              'x-csrf-token': document.getElementById('csrf-token-val').value
            }
          });
          const result = await response.json();
          if (result.success) {
            showToast('Contact deleted successfully.');
            triggerReload();
          } else {
            showToast('Failed to delete contact: ' + result.message, true);
          }
        } catch (err) {
          showToast('Network error while deleting contact.', true);
        }
      }
    }

    async function toggleContactFavorite(id) {
      try {
        const response = await fetch(`/admin/api/contacts/${id}/favorite`, {
          method: 'PATCH',
          headers: {
            'x-csrf-token': document.getElementById('csrf-token-val').value
          }
        });
        const result = await response.json();
        if (result.success) {
          showToast(result.data.favorite ? 'Added to favorites.' : 'Removed from favorites.');
          viewContact(id);
        }
      } catch (err) {
        showToast('Network error while toggling favorite.', true);
      }
    }

    function switchSettingsTab(tabName) {
      document.querySelectorAll('.settings-tab-item').forEach(el => el.classList.remove('active'));
      document.getElementById('pref-tab-view').style.display = 'none';
      document.getElementById('ident-tab-view').style.display = 'none';
      
      if (tabName === 'preferences') {
        document.getElementById('tab-pref').classList.add('active');
        document.getElementById('pref-tab-view').style.display = 'flex';
      } else {
        document.getElementById('tab-ident').classList.add('active');
        document.getElementById('ident-tab-view').style.display = 'flex';
        loadIdentitiesList();
      }
    }
  </script>
</body>
</html>