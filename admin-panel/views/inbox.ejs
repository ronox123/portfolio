    async function saveContact(id = null) {
      const name = document.getElementById('form-name').value;
      const email = document.getElementById('form-email').value;
      const additional_emails = document.getElementById('form-additional-emails').value;
      const company = document.getElementById('form-company').value;
      const job_title = document.getElementById('form-job').value;
      const phone = document.getElementById('form-phone').value;
      const notes = document.getElementById('form-notes').value;
      const favorite = document.getElementById('form-favorite').checked;

      if (!name || name.trim() === '') {
        alert('Name is required.');
        return;
      }

      const saveBtn = document.getElementById('contact-save-btn');
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
      }

      const method = id ? 'PUT' : 'POST';
      const url = id ? `/admin/api/contacts/${id}` : '/admin/api/contacts';

      try {
        const response = await fetch(url, {
          method,
          headers: {
