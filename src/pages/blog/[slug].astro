---
// src/pages/blog/[slug].astro
export const prerender = false; // Opt-out of static rendering (Astro Hybrid SSR)

import Layout from '../../layouts/Layout.astro';
import { DatabaseSync } from 'node:sqlite';
import path from 'path';

const { slug } = Astro.params;

// Database setup using process.cwd() for absolute path resolution in Astro runtime
const dbPath = path.join(process.cwd(), 'data', 'blog.db');
let post = null;

try {
  const db = new DatabaseSync(dbPath);
  const stmt = db.prepare("SELECT * FROM posts WHERE slug = ? AND status = 'published'");
  post = stmt.get(slug);
} catch (err) {
  console.error('Error querying database inside Astro blog post detail:', err);
}

// Redirect to 404 if post doesn't exist or is not published
if (!post) {
  return Astro.redirect('/404');
}

const pageTitle = post.meta_title || `${post.title} | Muhammad Ghufran`;
const pageDescription = post.meta_description || post.excerpt || '';
const publishDate = post.published_at 
  ? new Date(post.published_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : '';

// Generate share URLs
const shareUrl = encodeURIComponent(Astro.url.href);
const shareText = encodeURIComponent(`Check out this post: ${post.title}`);
---

<Layout title={pageTitle} description={pageDescription}>
  <article class="post-detail-section">
    <!-- Visual background patterns -->
    <div class="bg-grid-overlay" aria-hidden="true"></div>

    <div class="container post-detail-container">
      
      <!-- Back to Blog Navigation -->
      <a href="/blog" class="back-link link-underline-effect" aria-label="Go back to the blog listing">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="back-arrow" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Blog
      </a>

      <!-- Post Header Metadata -->
      <header class="post-header scroll-reveal">
        <div class="post-meta">
          <span class="badge" style="background-color: var(--color-secondary); color: var(--color-btn-secondary-text);">{post.category || 'General'}</span>
          <span class="meta-dot" aria-hidden="true">•</span>
          <span class="read-time">{post.read_time} Min Read</span>
          <span class="meta-dot" aria-hidden="true">•</span>
          <time datetime={post.published_at}>{publishDate}</time>
        </div>
        
        <h1 class="post-title">{post.title}</h1>
      </header>

      <!-- Post Cover Banner -->
      {post.cover_image && (
        <div class="post-cover scroll-reveal" style="transition-delay: 100ms;">
          <img src={post.cover_image} alt={`Cover image banner for ${post.title}`} />
        </div>
      )}

      <!-- Post Content Body (HTML parsed from rich text editor) -->
      <div class="post-content-body scroll-reveal" style="transition-delay: 200ms;">
        <div class="markdown-content">
          <Fragment set:html={post.content} />
        </div>
      </div>

      <!-- Share footer and bookmarks row -->
      <footer class="post-footer scroll-reveal" style="transition-delay: 250ms;">
        <hr class="footer-divider" />
        
        <div class="share-row">
          <span class="share-label">Share this post:</span>
          <div class="share-buttons">
            <!-- X/Twitter -->
            <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on X (Twitter)">
              X / Twitter
            </a>
            <!-- LinkedIn -->
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on LinkedIn">
              LinkedIn
            </a>
            <!-- WhatsApp -->
            <a href={`https://api.whatsapp.com/send?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label="Share on WhatsApp">
              WhatsApp
            </a>
            <!-- Copy Link -->
            <button id="copy-link-btn" class="share-btn" data-url={Astro.url.href} aria-label="Copy post link to clipboard">
              Copy Link
            </button>
          </div>
        </div>
      </footer>

    </div>
  </article>
</Layout>

<style>
  /* --- 1. Section Structure --- */
  .post-detail-section {
    position: relative;
    padding: var(--space-12) 0 var(--space-20);
    overflow: hidden;
    background: radial-gradient(circle at 90% 10%, rgba(var(--color-primary-rgb), 0.04) 0%, transparent 45%);
  }

  :global([data-theme="dark"]) .post-detail-section {
    background: radial-gradient(circle at 90% 10%, rgba(var(--color-secondary-rgb), 0.02) 0%, transparent 45%);
  }

  .post-detail-container {
    max-width: 780px; /* Constrains column reading width for long form */
    display: flex;
    flex-direction: column;
  }

  /* --- 2. Back Navigation link --- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary); /* Navy in light mode */
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
    align-self: flex-start;
    margin-bottom: var(--space-8);
    transition: color var(--transition-fast);
  }

  :global([data-theme="dark"]) .back-link {
    color: var(--color-secondary); /* Gold in dark mode */
  }

  .back-link:hover {
    color: var(--color-secondary-hover);
  }

  .back-arrow {
    transition: transform var(--transition-fast);
  }

  .back-link:hover .back-arrow {
    transform: translateX(-3px);
  }

  /* --- 3. Header --- */
  .post-header {
    margin-bottom: var(--space-8);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .meta-dot {
    color: var(--color-border);
  }

  .read-time {
    font-weight: var(--weight-medium);
  }

  .post-title {
    font-size: var(--text-2xl);
    color: var(--color-heading);
    line-height: var(--lh-tight);
    font-weight: var(--weight-bold);
  }

  /* --- 4. Cover image banner --- */
  .post-cover {
    width: 100%;
    height: 380px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-10);
    box-shadow: var(--shadow-sm);
  }

  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- 5. Rich Text Content Styles (TipTap HTML) --- */
  .post-content-body {
    font-size: var(--text-base);
    line-height: var(--lh-base);
    color: var(--color-text-secondary);
  }

  .markdown-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Semantic tags injected inside content fragment */
  .markdown-content :global(h2), 
  .markdown-content :global(h3) {
    color: var(--color-heading);
    font-weight: var(--weight-bold);
    margin-top: var(--space-8);
    margin-bottom: var(--space-2);
    line-height: var(--lh-tight);
  }

  .markdown-content :global(h2) { font-size: var(--text-lg); }
  .markdown-content :global(h3) { font-size: var(--text-md); }

  .markdown-content :global(p) {
    margin-bottom: var(--space-2);
  }

  .markdown-content :global(ul), 
  .markdown-content :global(ol) {
    margin-left: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .markdown-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .markdown-content :global(blockquote) {
    border-left: 4px solid var(--color-secondary);
    padding-left: var(--space-4);
    margin: var(--space-6) 0;
    font-style: italic;
    color: var(--color-text-primary);
  }

  .markdown-content :global(pre) {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .markdown-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-secondary);
    background-color: var(--color-bg-surface);
    padding: 0.1em 0.3em;
    border-radius: var(--radius-sm);
  }

  :global([data-theme="light"]) .markdown-content :global(code) {
    color: var(--color-primary); /* Navy in light theme for readability */
  }

  .markdown-content :global(pre code) {
    background-color: transparent;
    padding: 0;
    color: var(--color-text-primary);
  }

  .markdown-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
    border: 1px solid var(--color-border);
  }

  .markdown-content :global(a) {
    color: var(--color-secondary);
    font-weight: var(--weight-bold);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  :global([data-theme="light"]) .markdown-content :global(a) {
    color: var(--color-primary);
  }

  .markdown-content :global(a:hover) {
    color: var(--color-secondary-hover);
    border-bottom-color: var(--color-secondary-hover);
  }

  /* --- 6. Post Footer & Share Panel --- */
  .footer-divider {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: var(--space-10) 0 var(--space-6);
  }

  .share-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  @media (min-width: 480px) {
    .share-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .share-label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .share-btn {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    cursor: pointer;
    text-decoration: none;
    transition: background-color var(--transition-fast), 
                border-color var(--transition-fast), 
                color var(--transition-fast),
                transform var(--transition-fast);
  }

  .share-btn:hover {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
    transform: translateY(-1px);
  }

  /* --- 7. Scroll Reveal States --- */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }

  .scroll-reveal.animate {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .post-cover {
      height: 240px;
    }
  }
</style>

<!-- Copy Link Script & Observer -->
<script>
  const setupPostDetail = () => {
    // Copy link helper
    const copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const url = copyBtn.getAttribute('data-url');
        if (url) {
          navigator.clipboard.writeText(url).then(() => {
            const originalText = copyBtn.innerText;
            copyBtn.innerText = 'Copied!';
            copyBtn.style.borderColor = 'var(--color-secondary)';
            copyBtn.style.color = 'var(--color-secondary)';
            setTimeout(() => {
              copyBtn.innerText = originalText;
              copyBtn.style.borderColor = 'var(--color-border)';
              copyBtn.style.color = 'var(--color-text-primary)';
            }, 2000);
          }).catch(err => {
            console.error('Failed to copy text: ', err);
          });
        }
      });
    }

    // Scroll Observer reveals
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.05,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    document.querySelectorAll('.scroll-reveal').forEach((el) => {
      observer.observe(el);
    });
  };

  document.addEventListener('DOMContentLoaded', setupPostDetail);
  document.addEventListener('astro:after-swap', setupPostDetail);
</script>
