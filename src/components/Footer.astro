---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    
    <!-- Left Column: Branding & Tagline -->
    <div class="footer-info">
      <a href="#hero" class="footer-logo">
        Ghufran<span class="logo-dot">.</span>
      </a>
      <p class="footer-tagline">
        Systems builder combining AI automation, content workflows, and custom code to build operations that run themselves.
      </p>
    </div>
    
    <!-- Right Column: Navigation Coordinates & Social Connections -->
    <div class="footer-links-container">
      <div class="footer-nav">
        <span class="footer-title">Navigation</span>
        <ul class="footer-list">
          <li><a href="#about">About</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#process">Process</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
      
      <div class="footer-socials">
        <span class="footer-title">Connect</span>
        <ul class="footer-list">
          <li>
            <a href="mailto:mghufran1057@gmail.com" class="footer-social-link">
              <!-- Envelope icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="footer-icon" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              Email
            </a>
          </li>
          <li>
            <a href="https://wa.me/923190405781" target="_blank" rel="noopener noreferrer" class="footer-social-link">
              <!-- Speech Bubble icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="footer-icon" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>
    
  </div>
  
  <!-- Bottom Copyright Row -->
  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p class="copyright-text">
        &copy; {currentYear} Muhammad Ghufran. All rights reserved.
      </p>
      <p class="tagline-sub">
        Built with Astro &amp; CSS Variables.
      </p>
    </div>
  </div>
</footer>

<style>
  /* --- 1. Footer Container Structure --- */
  .footer {
    background-color: var(--color-bg-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-16) 0 var(--space-6);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  /* --- 2. Left Column: Branding and Intro --- */
  .footer-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: var(--weight-extrabold);
    color: var(--color-heading);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .logo-dot {
    color: var(--color-secondary);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
    max-width: 45ch;
  }

  /* --- 3. Right Column: Link Groups --- */
  .footer-links-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  .footer-title {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--space-4);
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-list a {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    border-bottom: 2px solid transparent;
  }

  .footer-list a:hover {
    color: var(--color-secondary);
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-icon {
    flex-shrink: 0;
    color: var(--color-secondary);
  }

  /* --- 4. Bottom copyright strip --- */
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
    transition: border-color var(--transition-base);
  }

  .footer-bottom-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .footer-bottom-container {
      flex-direction: row;
    }
  }

  .copyright-text,
  .tagline-sub {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
