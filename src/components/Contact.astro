<section id="contact" class="contact-section">
  <div class="container contact-container">
    
    <!-- Section Header (Centered layout) -->
    <div class="contact-header scroll-reveal">
      <span class="contact-eyebrow">Get In Touch</span>
      <h2 class="contact-heading">Let's build something that runs on its own.</h2>
      <p class="contact-subtext text-muted">
        Whether it's automating a repetitive workflow, scaling a content system, or building a custom tool — if you want to work with someone who ships, let's talk.
      </p>
    </div>
    
    <!-- Centered Content Wrapper -->
    <div class="contact-content scroll-reveal" style="transition-delay: 150ms;">
      <p class="info-intro">
        I work best with people who want to move fast and build real systems — not just talk about ideas. If that's you, reach out directly.
      </p>
      
      <!-- Checklist of project scopes -->
      <ul class="best-for-list" role="list">
        <li class="list-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Automating a repetitive workflow</span>
        </li>
        <li class="list-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Building or scaling a content system</span>
        </li>
        <li class="list-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Custom tools or website builds</span>
        </li>
      </ul>
      
      <!-- Direct prominent contact methods (Equal width cards) -->
      <div class="contact-methods">
        
        <!-- Card A: Email -->
        <a href="mailto:mghufran1057@gmail.com" class="contact-card" aria-label="Send an email to mghufran1057@gmail.com">
          <div class="card-icon-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="card-icon" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="card-details">
            <span class="card-label">Email</span>
            <span class="card-value">mghufran1057@gmail.com</span>
            <span class="card-caption">Send a direct message</span>
          </div>
        </a>
        
        <!-- Card B: WhatsApp -->
        <a href="https://wa.me/923190405781" target="_blank" rel="noopener noreferrer" class="contact-card" aria-label="Chat on WhatsApp with Muhammad Ghufran (opens in a new tab)">
          <div class="card-icon-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="card-icon" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <div class="card-details">
            <span class="card-label">WhatsApp</span>
            <span class="card-value">+92 319 0405781</span>
            <span class="card-caption">Tap to chat directly</span>
          </div>
        </a>
        
      </div>
    </div>
    
  </div>
</section>

<style>
  /* --- 1. Section & Background Setup --- */
  .contact-section {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
    /* Soft blurred warm backdrop */
    background: radial-gradient(circle at 50% 80%, rgba(var(--color-secondary-rgb), 0.05) 0%, transparent 50%);
  }

  .contact-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* --- 2. Section Header --- */
  .contact-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact-eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-2);
  }

  .contact-heading {
    font-size: var(--text-2xl);
    color: var(--color-heading);
    margin-bottom: var(--space-3);
  }

  .contact-subtext {
    font-size: var(--text-base);
    max-width: 65ch;
  }

  /* --- 3. Centered Content Panel --- */
  .contact-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 680px; /* Constrains column widths on large screens */
    margin: 0 auto;
    width: 100%;
  }

  .info-intro {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
    text-align: center;
    margin-bottom: var(--space-6);
  }

  /* Checklist grouping */
  .best-for-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start; /* Left aligns checks inside the centered wrapper */
    margin-bottom: var(--space-10);
  }

  .list-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
  }

  .check-icon {
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  .list-item span {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  /* --- 4. Main Direct Contact Cards (2 columns side-by-side) --- */
  .contact-methods {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    width: 100%;
  }

  @media (min-width: 768px) {
    .contact-methods {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6); /* Generous padding */
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), 
                box-shadow var(--transition-base), 
                border-color var(--transition-base), 
                background-color var(--transition-base);
  }

  .contact-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-secondary);
    box-shadow: var(--shadow-glow), var(--shadow-md);
  }

  .card-icon-badge {
    width: 56px; /* Expanded badge size */
    height: 56px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    flex-shrink: 0;
    transition: border-color var(--transition-base);
  }

  .contact-card:hover .card-icon-badge {
    border-color: var(--color-secondary);
  }

  .contact-card .card-icon {
    transition: transform var(--transition-base);
  }

  .contact-card:hover .card-icon {
    transform: scale(1.08);
  }

  .card-details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .card-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-value {
    font-family: var(--font-heading);
    font-size: var(--text-md); /* Prominent visual focal point */
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .contact-card:hover .card-value {
    color: var(--color-secondary-hover);
  }

  .card-caption {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* --- 5. Scroll Reveal --- */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }

  .scroll-reveal.animate {
    opacity: 1;
    transform: translateY(0);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .contact-card:hover {
      transform: none !important;
    }
  }
</style>

<!-- Scroll Reveal Trigger Handler -->
<script>
  const setupContactReveal = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.05,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    document.querySelectorAll('.scroll-reveal').forEach((el) => {
      observer.observe(el);
    });
  };

  const init = () => {
    requestAnimationFrame(() => {
      setTimeout(setupContactReveal, 50);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:after-swap', init);
</script>
