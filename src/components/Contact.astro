---
// src/components/Contact.astro
---

<section id="contact" class="contact-section">
  <div class="container contact-container">
    
    <!-- Section Header (Centered layout) -->
    <div class="contact-header scroll-reveal">
      <span class="contact-eyebrow">Get In Touch</span>
      <h2 class="contact-heading">Let's build something that runs on its own.</h2>
      <p class="contact-subtext text-muted">
        Whether it's automating a repetitive workflow, scaling a content system, or building a custom tool — if you want to work with someone who ships, let's talk.
      </p>
    </div>
    
    <!-- Split Layout Grid -->
    <div class="contact-grid scroll-reveal" style="transition-delay: 150ms;">
      
      <!-- Left Column: Details & Direct Links -->
      <div class="contact-info-panel">
        <p class="info-intro">
          I work best with fast-moving builders who want to launch real automated channels or custom software systems. Reach out directly or submit the project details form.
        </p>
        
        <!-- Checklist of project scopes -->
        <ul class="best-for-list" role="list">
          <li class="list-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Automating repetitive workflows</span>
          </li>
          <li class="list-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Building or scaling content systems</span>
          </li>
          <li class="list-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Custom integrations or website builds</span>
          </li>
        </ul>
        
        <!-- Direct contact methods -->
        <div class="contact-methods">
          <!-- Card A: Email -->
          <a href="mailto:mghufran1057@gmail.com" class="contact-card" aria-label="Send an email to mghufran1057@gmail.com">
            <div class="card-icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="card-icon email-icon" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="card-details">
              <span class="card-label">Email</span>
              <span class="card-value">mghufran1057@gmail.com</span>
              <span class="card-caption">Send a direct message</span>
            </div>
          </a>
          
          <!-- Card B: WhatsApp -->
          <a href="https://wa.me/923190405781" target="_blank" rel="noopener noreferrer" class="contact-card" aria-label="Chat on WhatsApp with Muhammad Ghufran">
            <div class="card-icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="card-icon whatsapp-icon" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <div class="card-details">
              <span class="card-label">WhatsApp</span>
              <span class="card-value">+92 319 0405781</span>
              <span class="card-caption">Tap to chat directly</span>
            </div>
          </a>
        </div>
      </div>
      
      <!-- Right Column: Interactive Form -->
      <div class="contact-form-container">
        <form id="contact-project-form" class="contact-form" novalidate>
          
          <!-- Loading Overlay -->
          <div id="form-loading-overlay" class="form-overlay">
            <div class="form-spinner"></div>
            <h3 class="mt-2">Sending Message</h3>
            <p class="text-muted text-sm mt-1">Please wait while your project details are submitted...</p>
          </div>

          <!-- Success Overlay -->
          <div id="form-success-overlay" class="form-overlay">
            <div class="success-checkmark">
              <div class="check-icon">
                <span class="icon-line line-tip"></span>
                <span class="icon-line line-long"></span>
                <div class="icon-circle"></div>
              </div>
            </div>
            <h3 class="mb-2">Message Sent!</h3>
            <p class="success-message-text">
              Thank you for contacting us! Your message has been successfully submitted. We appreciate your interest and will get back to you as soon as possible.
            </p>
            <button type="button" id="success-done-btn" class="btn btn-secondary mt-6">Send Another Message</button>
          </div>

          <!-- Form inputs -->
          <div class="form-row form-row-2">
            <div class="form-group">
              <label for="form-name" class="form-label">Full Name</label>
              <input type="text" id="form-name" name="name" class="form-input" placeholder="John Doe" required />
              <span id="error-name" class="form-error-msg" style="display: none;"></span>
            </div>

            <div class="form-group">
              <label for="form-email" class="form-label">Email Address</label>
              <input type="email" id="form-email" name="email" class="form-input" placeholder="john@example.com" required />
              <span id="error-email" class="form-error-msg" style="display: none;"></span>
            </div>
          </div>

          <div class="form-row form-row-2">
            <div class="form-group">
              <label for="form-company" class="form-label">Company Name <span class="text-muted">(Optional)</span></label>
              <input type="text" id="form-company" name="company" class="form-input" placeholder="Acme Inc." />
            </div>

            <div class="form-group">
              <label for="form-subject" class="form-label">Subject</label>
              <input type="text" id="form-subject" name="subject" class="form-input" placeholder="Project Inquiry" required />
              <span id="error-subject" class="form-error-msg" style="display: none;"></span>
            </div>
          </div>

          <div class="form-group">
            <label for="form-message" class="form-label">Message</label>
            <textarea id="form-message" name="message" class="form-textarea" placeholder="Tell me about what you are building..." required></textarea>
            <span id="error-message" class="form-error-msg" style="display: none;"></span>
          </div>

          <div id="form-submit-error" class="form-error-msg" style="display: none; background-color: rgba(239, 68, 68, 0.1); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid rgba(239, 68, 68, 0.2); font-weight: 600;">
            <!-- Submit error placeholder -->
          </div>

          <button type="submit" id="form-submit-btn" class="btn btn-primary mt-2" style="width: 100%;">
            Send Inquiry
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<style>
  /* --- 1. Section & Background Setup --- */
  .contact-section {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
    background: radial-gradient(circle at 50% 85%, rgba(var(--color-secondary-rgb), 0.03) 0%, transparent 60%);
  }

  .contact-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* --- 2. Section Header --- */
  .contact-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact-eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-2);
  }

  .contact-heading {
    font-size: var(--text-2xl);
    color: var(--color-heading);
    margin-bottom: var(--space-3);
  }

  .contact-subtext {
    font-size: var(--text-base);
    max-width: 65ch;
  }

  /* --- 3. Split Layout Grid --- */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 0.95fr 1.05fr;
      gap: var(--space-12);
    }
  }

  .contact-info-panel {
    display: flex;
    flex-direction: column;
  }

  .info-intro {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
    margin-bottom: var(--space-6);
  }

  /* Checklist grouping */
  .best-for-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-8);
  }

  .list-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
  }

  .check-icon {
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  .list-item span {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  /* Direct contact methods */
  .contact-methods {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    width: 100%;
  }

  @media (min-width: 640px) {
    .contact-methods {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .contact-methods {
      grid-template-columns: 1fr;
    }
  }

  .contact-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6) var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    text-decoration: none;
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.03);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-secondary);
    box-shadow: var(--shadow-md);
    background-color: var(--color-bg-surface-hover);
  }

  .card-icon-badge {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-card:hover .card-icon-badge {
    background-color: var(--color-secondary);
    color: var(--color-btn-secondary-text);
    border-color: var(--color-secondary);
  }

  .contact-card .card-icon {
    width: 16px;
    height: 16px;
    transition: transform var(--transition-base);
  }

  .card-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    z-index: 2;
  }

  .card-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-value {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-extrabold);
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .contact-card:hover .card-value {
    color: var(--color-secondary-hover);
  }

  .card-caption {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .contact-card:hover {
      transform: none !important;
    }
  }
</style>

<!-- Client Controller Script for Form Validation and AJAX Submissions -->
<script>
  const setupContactForm = () => {
    const form = document.getElementById('contact-project-form');
    if (!form) return;

    const fields = {
      name: {
        input: document.getElementById('form-name'),
        error: document.getElementById('error-name'),
        validate: (val) => val.trim() ? '' : 'Full name is required.'
      },
      email: {
        input: document.getElementById('form-email'),
        error: document.getElementById('error-email'),
        validate: (val) => {
          if (!val.trim()) return 'Email address is required.';
          const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          return regex.test(val.trim()) ? '' : 'Please enter a valid email address.';
        }
      },
      subject: {
        input: document.getElementById('form-subject'),
        error: document.getElementById('error-subject'),
        validate: (val) => val.trim() ? '' : 'Subject is required.'
      },
      message: {
        input: document.getElementById('form-message'),
        error: document.getElementById('error-message'),
        validate: (val) => val.trim() ? '' : 'Message is required.'
      }
    };

    const loadingOverlay = document.getElementById('form-loading-overlay');
    const successOverlay = document.getElementById('form-success-overlay');
    const submitError = document.getElementById('form-submit-error');
    const submitBtn = document.getElementById('form-submit-btn');
    const doneBtn = document.getElementById('success-done-btn');

    let isSubmitting = false;

    // Validate a specific field and update UI
    const validateField = (name) => {
      const field = fields[name];
      if (!field.input) return true;

      const errorMsg = field.validate(field.input.value);
      if (errorMsg) {
        field.input.classList.add('is-invalid');
        field.error.textContent = errorMsg;
        field.error.style.display = 'block';
        return false;
      } else {
        field.input.classList.remove('is-invalid');
        field.error.style.display = 'none';
        return true;
      }
    };

    // Clear invalid styling dynamically as the user types
    Object.keys(fields).forEach(key => {
      const field = fields[key];
      if (field.input) {
        field.input.addEventListener('input', () => {
          if (field.input.classList.contains('is-invalid')) {
            validateField(key);
          }
        });
      }
    });

    // Reset Form State
    const resetForm = () => {
      form.reset();
      Object.keys(fields).forEach(key => {
        const field = fields[key];
        if (field.input) {
          field.input.classList.remove('is-invalid');
          field.error.style.display = 'none';
        }
      });
      submitError.style.display = 'none';
      successOverlay.classList.remove('active');
      loadingOverlay.classList.remove('active');
      isSubmitting = false;
      submitBtn.removeAttribute('disabled');
    };

    doneBtn?.addEventListener('click', resetForm);

    // Form Submit Event
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;

      submitError.style.display = 'none';

      // Validate all fields
      let isValid = true;
      Object.keys(fields).forEach(key => {
        const isFieldValid = validateField(key);
        if (!isFieldValid) isValid = false;
      });

      if (!isValid) return;

      // Lock submissions
      isSubmitting = true;
      submitBtn.setAttribute('disabled', 'true');
      loadingOverlay.classList.add('active');

      const formData = {
        name: fields.name.input.value,
        email: fields.email.input.value,
        company: document.getElementById('form-company')?.value || '',
        subject: fields.subject.input.value,
        message: fields.message.input.value
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(formData)
        });

        const result = await response.json();

        // Simulate a tiny delay for visual flow and premium feel
        await new Promise(resolve => setTimeout(resolve, 800));

        if (response.ok && result.success) {
          // Success workflow
          loadingOverlay.classList.remove('active');
          successOverlay.classList.add('active');
          form.reset();
        } else {
          // Server-side validation failure
          loadingOverlay.classList.remove('active');
          submitError.textContent = result.error || 'Failed to submit the form. Please check your inputs.';
          submitError.style.display = 'block';
          submitBtn.removeAttribute('disabled');
          isSubmitting = false;
        }
      } catch (err) {
        console.error('Submit error:', err);
        loadingOverlay.classList.remove('active');
        submitError.textContent = 'A network error occurred. Please check your internet connection and try again.';
        submitError.style.display = 'block';
        submitBtn.removeAttribute('disabled');
        isSubmitting = false;
      }
    });
  };

  const setupContactReveal = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.05,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    document.querySelectorAll('.scroll-reveal').forEach((el) => {
      observer.observe(el);
    });
  };

  const init = () => {
    setupContactForm();
    requestAnimationFrame(() => {
      setTimeout(setupContactReveal, 50);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:after-swap', init);
</script>
