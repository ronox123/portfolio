---
// src/components/TechStack.astro
---

<section id="tech-stack" class="techstack-section">
  <!-- Subtle background grid pattern -->
  <div class="bg-grid-overlay" aria-hidden="true"></div>

  <div class="container techstack-container">
    
    <!-- Section Header -->
    <div class="techstack-header scroll-reveal">
      <span class="techstack-eyebrow">Tools & Stack</span>
      <h2 class="techstack-heading">What I build with.</h2>
      <p class="techstack-subtext text-muted">
        A curated selection of languages, platforms, and frameworks I use to design and deploy automated assets.
      </p>
    </div>
    
    <!-- Responsive Tool Grid -->
    <div class="techstack-grid scroll-reveal" style="transition-delay: 150ms;">
      
      <!-- Tool 1: n8n -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- Custom n8n Nodes Logo Connection -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <rect x="3" y="11" width="4" height="4" rx="1"></rect>
            <rect x="17" y="11" width="4" height="4" rx="1"></rect>
            <rect x="10" y="3" width="4" height="4" rx="1"></rect>
            <rect x="10" y="17" width="4" height="4" rx="1"></rect>
            <path d="M7 13h3m4 0h3m-5-6v4m0 4v4"></path>
          </svg>
        </div>
        <span class="tool-name">n8n</span>
      </div>
      
      <!-- Tool 2: JS/TS -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- JS / Code Braces Logo -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
            <line x1="14" y1="4" x2="10" y2="20"></line>
          </svg>
        </div>
        <span class="tool-name">JavaScript & TS</span>
      </div>
      
      <!-- Tool 3: Astro -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- Astro Launch Rocket Logo -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <path d="M4.5 16.5c-1.5 1.25-2.5 3.5-2.5 3.5s2.25-1 3.5-2.5M12 2C6.5 2 2 6.5 2 12c0 2 1 3.5 2 4.5L12 9l2.5 2.5L7.5 18c1 1 2.5 2 4.5 2 5.5 0 10-4.5 10-10S17.5 2 12 2z"></path>
            <path d="M9 15h.01M15 9h.01"></path>
          </svg>
        </div>
        <span class="tool-name">Astro.js</span>
      </div>
      
      <!-- Tool 4: HTML & CSS -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- HTML/CSS Design Layout Grid -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
          </svg>
        </div>
        <span class="tool-name">HTML5 & CSS3</span>
      </div>
      
      <!-- Tool 5: Adobe Stock -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- Adobe Stock Imagery Palette -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            <path d="M2 12h20"></path>
          </svg>
        </div>
        <span class="tool-name">Adobe Stock</span>
      </div>
      
      <!-- Tool 6: Google Flow -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- Google Flow Workflow Nodes -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <circle cx="6" cy="6" r="3"></circle>
            <circle cx="18" cy="18" r="3"></circle>
            <circle cx="18" cy="6" r="3"></circle>
            <line x1="9" y1="6" x2="15" y2="6"></line>
            <line x1="18" y1="9" x2="18" y2="15"></line>
            <path d="M6 9v7a3 3 0 0 0 3 3h6"></path>
          </svg>
        </div>
        <span class="tool-name">Google Flow</span>
      </div>
      
      <!-- Tool 7: Chrome Extensions -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- Chrome Extension Puzzle Piece -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <path d="M12 22v-4h3.85a1.15 1.15 0 0 0 1.15-1.15V13h4a1.15 1.15 0 0 0 1.15-1.15v-3.7A1.15 1.15 0 0 0 21 7h-4V3.15A1.15 1.15 0 0 0 15.85 2H12v4H8.15A1.15 1.15 0 0 0 7 7.15v3.7A1.15 1.15 0 0 0 8.15 12h4v3.85A1.15 1.15 0 0 0 11 17H7.15A1.15 1.15 0 0 0 6 18.15v3.7A1.15 1.15 0 0 0 7.15 23H12v-1z"></path>
          </svg>
        </div>
        <span class="tool-name">Chrome Extensions</span>
      </div>
      
      <!-- Tool 8: VS Code -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- VS Code Editor Window Mockup -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
            <line x1="7" y1="20" x2="7" y2="10"></line>
          </svg>
        </div>
        <span class="tool-name">VS Code</span>
      </div>
      
      <!-- Tool 9: Git/GitHub -->
      <div class="tool-card">
        <div class="tool-icon-wrapper">
          <!-- Git Branching Fork Logo -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tool-icon">
            <line x1="6" y1="3" x2="6" y2="15"></line>
            <circle cx="18" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <path d="M18 9a9 9 0 0 1-9 9"></path>
          </svg>
        </div>
        <span class="tool-name">Git & GitHub</span>
      </div>
      
    </div>
  </div>
</section>

<style>
  /* --- 1. Section & Background Setup --- */
  .techstack-section {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
    /* Soft lighting gradient positioned asymmetrically */
    background: radial-gradient(circle at 80% 80%, rgba(var(--color-primary-rgb), 0.05) 0%, transparent 45%);
  }

  :global([data-theme="dark"]) .techstack-section {
    background: radial-gradient(circle at 80% 80%, rgba(var(--color-secondary-rgb), 0.03) 0%, transparent 45%);
  }

  .techstack-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* --- 2. Section Header --- */
  .techstack-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .techstack-eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-2);
  }

  .techstack-heading {
    font-size: var(--text-2xl);
    color: var(--color-heading);
    margin-bottom: var(--space-3);
  }

  .techstack-subtext {
    font-size: var(--text-base);
    max-width: 65ch;
  }

  /* --- 3. Responsive Grid and Cards --- */
  .techstack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 480px) {
    .techstack-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  @media (min-width: 768px) {
    .techstack-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .techstack-grid {
      grid-template-columns: repeat(9, 1fr);
    }
  }

  /* Tool Badge Card styling */
  .tool-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base);
  }

  .tool-card:hover {
    transform: scale(1.05) translateY(-3px);
    border-color: var(--color-secondary);
    box-shadow: var(--shadow-glow), var(--shadow-md);
  }

  /* Circular Icon Wrapper */
  .tool-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary); /* Default dark navy in light mode */
    transition: border-color var(--transition-base), color var(--transition-base), box-shadow var(--transition-base);
  }

  :global([data-theme="dark"]) .tool-icon-wrapper {
    color: var(--color-text-secondary); /* slate in dark mode */
  }

  .tool-icon {
    width: 22px;
    height: 22px;
    transition: transform var(--transition-base);
  }

  .tool-card:hover .tool-icon-wrapper {
    border-color: var(--color-secondary);
    color: var(--color-secondary); /* shifts to gold on hover */
    box-shadow: 0 0 10px rgba(var(--color-secondary-rgb), 0.15);
  }

  .tool-card:hover .tool-icon {
    transform: scale(1.1);
  }

  .tool-name {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  /* --- 4. Responsive Mobile Adaptations --- */
  @media (max-width: 768px) {
    .techstack-section {
      padding: var(--space-12) 0;
    }

    .techstack-header {
      align-items: center;
      text-align: center;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tool-card:hover {
      transform: none !important;
    }
    .tool-icon {
      transform: none !important;
    }
  }
</style>

<!-- Scroll Reveal Script -->
<script>
  const observeTechStack = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.05,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    document.querySelectorAll('.scroll-reveal').forEach((el) => {
      observer.observe(el);
    });
  };

  const init = () => {
    requestAnimationFrame(() => {
      setTimeout(observeTechStack, 50);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:after-swap', init);
</script>
