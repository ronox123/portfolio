---
// src/components/About.astro
---

<section id="about" class="about-section">
  <div class="container about-container">
    
    <!-- Section Header (Updated with gold highlight and high contrast base) -->
    <div class="about-header scroll-reveal">
      <span class="about-eyebrow">About Me</span>
      <h2 class="about-heading">Young by age. <span class="highlight-text">Systematic</span> by design.</h2>
    </div>
    
    <!-- Main Content Grid -->
    <div class="about-grid">
      
      <!-- Left Column: Narrative (60% width on desktop) -->
      <div class="about-narrative scroll-reveal" style="transition-delay: 150ms;">
        <p class="lead-paragraph">
          I'm Muhammad Ghufran — an 18-year-old 2nd-year student, class topper, and active member of the elite AI Squad community. But grades were never the real scoreboard for me.
        </p>
        
        <p>
          About 1.5 years ago, I entered the world of AI automation through the Emergi AI community. Instead of just studying courses and collecting theoretical knowledge, I immediately started building. I taught myself faceless YouTube automation and engineered custom n8n workflows, creating systems that deliver real, repeatable results. I don't just learn systems — I build them, break them, and rebuild them until they run on their own.
        </p>
        
        <!-- Pull Quote Block (High Contrast, italic visual callout) -->
        <div class="pull-quote">
          <p>"I don't just learn systems — I build them until they run without me."</p>
        </div>
        
        <p>
          While most people my age are still planning their next steps, I'm already developing automated assets and scaling YouTube systems, all while balancing my academic workload. My ambition goes beyond digital systems; I'm currently launching a physical cattle farm to learn brick-and-mortar operations. For me, everything is a system waiting to be designed, optimized, and scaled.
        </p>
      </div>
      
      <!-- Right Column: Snapshot Card (40% width on desktop) -->
      <div class="about-sidebar scroll-reveal" style="transition-delay: 300ms;">
        <div class="stats-card">
          <h3 class="card-title">Snapshot</h3>
          
          <div class="stats-grid">
            <!-- Stat Item 1 -->
            <div class="stat-item">
              <div class="stat-header">
                <!-- TV/Play Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stat-icon" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="m10 15 5-3-5-3v6Z"></path>
                </svg>
                <span class="stat-number">4-5</span>
              </div>
              <span class="stat-label">Channels Built & Monetized</span>
            </div>
            
            <!-- Stat Item 2 -->
            <div class="stat-item">
              <div class="stat-header">
                <!-- Calendar/Time Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stat-icon" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span class="stat-number">1.5+ Yrs</span>
              </div>
              <span class="stat-label">In AI Automation & Systems</span>
            </div>
            
            <!-- Stat Item 3 -->
            <div class="stat-item">
              <div class="stat-header">
                <!-- Target Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stat-icon" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="6"></circle>
                  <circle cx="12" cy="12" r="2"></circle>
                </svg>
                <span class="stat-number">S+ Tier</span>
              </div>
              <span class="stat-label">Niche Research Specialist</span>
            </div>
            
            <!-- Stat Item 4 -->
            <div class="stat-item">
              <div class="stat-header">
                <!-- Group Node Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stat-icon" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span class="stat-number">AI Squad</span>
              </div>
              <span class="stat-label">Active Community Member</span>
            </div>
          </div>
          
          <hr class="card-divider" />
          
          <!-- Current Focus Pill List -->
          <div class="focus-section">
            <span class="focus-title">Currently focused on:</span>
            <div class="focus-tags">
              <span class="pill">Scaling to 10+ Channels</span>
              <span class="pill">n8n Automation</span>
              <span class="pill">AI Tool Building</span>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  /* --- 1. Section & Background Setup --- */
  .about-section {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
    /* Soft warm blur element mapping to the active theme's secondary color */
    background: radial-gradient(circle at 90% 10%, rgba(var(--color-secondary-rgb), 0.08) 0%, transparent 50%);
  }

  .about-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* --- 2. Section Header --- */
  .about-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .about-eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-2);
  }

  .about-heading {
    font-size: var(--text-2xl);
    /* Corrected: Uses var(--color-heading) for automatic theme-adapting high contrast */
    color: var(--color-heading);
  }

  .highlight-text {
    color: var(--color-secondary); /* Gold text accent touch on dark base */
  }

  /* --- 3. Grid Columns --- */
  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: start;
  }

  /* --- 4. Narrative Column Styling --- */
  .about-narrative {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .lead-paragraph {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    line-height: var(--lh-snug);
  }

  /* Callout Pull Quote (Corrected color and styling) */
  .pull-quote {
    border-left: 4px solid var(--color-secondary);
    padding-left: var(--space-4);
    margin: var(--space-6) 0;
  }

  .pull-quote p {
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary); /* Corrected from var(--color-primary) to make it readable */
    line-height: var(--lh-tight);
    font-style: italic; /* Added italic treatment for visual callout */
  }

  /* --- 5. Stats Sidebar Card --- */
  .about-sidebar {
    display: flex;
    flex-direction: column;
  }

  .stats-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base);
  }

  .stats-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-secondary);
  }

  .card-title {
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
    font-weight: var(--weight-bold);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .stat-icon {
    color: var(--color-primary);
    opacity: 1;
    flex-shrink: 0;
    transition: color var(--transition-base);
  }

  :global([data-theme="dark"]) .stat-icon {
    color: var(--color-secondary);
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    transition: color var(--transition-base);
  }

  :global([data-theme="dark"]) .stat-number {
    color: var(--color-secondary);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-secondary); /* High-contrast light slate label text */
    line-height: var(--lh-tight);
  }

  .card-divider {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: var(--space-6) 0;
    transition: border-color var(--transition-base);
  }

  .focus-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .focus-title {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }



  /* --- 7. Responsive Mobile Adaptations (Mobile First) --- */
  @media (max-width: 768px) {
    .about-section {
      padding: var(--space-12) 0;
    }

    .about-header {
      align-items: center;
      text-align: center;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .about-narrative {
      order: 1; /* Narrative goes first on mobile */
    }

    .about-sidebar {
      order: 2; /* Stats card goes below narrative */
    }

    .stats-card {
      padding: var(--space-6);
    }

    .stats-grid {
      gap: var(--space-4);
    }
  }


</style>

<!-- Scroll Reveal Script -->
<script>
  const observeElements = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.05,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    document.querySelectorAll('.scroll-reveal').forEach((el) => {
      observer.observe(el);
    });
  };

  const init = () => {
    requestAnimationFrame(() => {
      setTimeout(observeElements, 50);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:after-swap', init);
</script>
