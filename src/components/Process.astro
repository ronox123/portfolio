---
// src/components/Process.astro
---

<section id="process" class="process-section">
  <div class="container process-container">
    
    <!-- Section Header -->
    <div class="process-header scroll-reveal">
      <span class="process-eyebrow">How I Work</span>
      <h2 class="process-heading">The system behind the results.</h2>
      <p class="process-subtext text-muted">
        Every project — from automation pipelines to digital content — follows the same repeatable process.
      </p>
    </div>
    
    <!-- Connected Steps Layout -->
    <div class="process-flow scroll-reveal-flow">
      <!-- Connection Pipeline Lines (Desktop horizontal / Mobile vertical) -->
      <div class="flow-line desktop-only" aria-hidden="true"></div>
      <div class="flow-line mobile-only" aria-hidden="true"></div>
      
      <!-- Sequence list of steps -->
      <ol class="steps-list" role="list">
        
        <!-- Step 01: Research & Discovery -->
        <li class="step-item" style="--step-index: 1;">
          <div class="step-card">
            <div class="step-header">
              <span class="step-watermark">01</span>
              <div class="step-icon-badge">
                <!-- Search Glass Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="step-icon" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>
            </div>
            <h3 class="step-title">Research & Discovery</h3>
            <p class="step-description">
              Every system starts with deep research — analyzing data, finding market gaps, and locating the highest-leverage opportunities before writing any logic.
            </p>
          </div>
        </li>
        
        <!-- Step 02: System Design -->
        <li class="step-item" style="--step-index: 2;">
          <div class="step-card">
            <div class="step-header">
              <span class="step-watermark">02</span>
              <div class="step-icon-badge">
                <!-- Blueprint Nodes Connected Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="step-icon" aria-hidden="true">
                  <rect x="3" y="3" width="6" height="6" rx="1"></rect>
                  <rect x="15" y="3" width="6" height="6" rx="1"></rect>
                  <rect x="9" y="15" width="6" height="6" rx="1"></rect>
                  <line x1="6" y1="9" x2="6" y2="12"></line>
                  <line x1="6" y1="12" x2="12" y2="12"></line>
                  <line x1="12" y1="12" x2="12" y2="15"></line>
                  <line x1="18" y1="9" x2="18" y2="12"></line>
                  <line x1="18" y1="12" x2="12" y2="12"></line>
                </svg>
              </div>
            </div>
            <h3 class="step-title">System Design</h3>
            <p class="step-description">
              I map out the full workflow before building — defining triggers, data nodes, and integrations so the system is built with structural foresight, not reactively.
            </p>
          </div>
        </li>
        
        <!-- Step 03: Build & Automate -->
        <li class="step-item" style="--step-index: 3;">
          <div class="step-card">
            <div class="step-header">
              <span class="step-watermark">03</span>
              <div class="step-icon-badge">
                <!-- Wrench/Automation Gear Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="step-icon" aria-hidden="true">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
              </div>
            </div>
            <h3 class="step-title">Build & Automate</h3>
            <p class="step-description">
              Execution phase. I engineer the actual workflow, combining code frameworks with automation speed to build stable systems that perform reliably under load.
            </p>
          </div>
        </li>
        
        <!-- Step 04: Launch & Scale -->
        <li class="step-item" style="--step-index: 4;">
          <div class="step-card">
            <div class="step-header">
              <span class="step-watermark">04</span>
              <div class="step-icon-badge">
                <!-- Rocket Launch Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="step-icon" aria-hidden="true">
                  <path d="M4.5 16.5c-1.5 1.25-2.5 3.5-2.5 3.5s2.25-1 3.5-2.5M12 2C6.5 2 2 6.5 2 12c0 2 1 3.5 2 4.5L12 9l2.5 2.5L7.5 18c1 1 2.5 2 4.5 2 5.5 0 10-4.5 10-10S17.5 2 12 2z"></path>
                </svg>
              </div>
            </div>
            <h3 class="step-title">Launch & Scale</h3>
            <p class="step-description">
              Once active, I audit outputs, optimize flow speeds, and expand operations — replicating the successful patterns across new channels and workflows.
            </p>
          </div>
        </li>
        
      </ol>
    </div>
  </div>
</section>

<style>
  /* --- 1. Section & Background Setup --- */
  .process-section {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
    background: radial-gradient(circle at 85% 75%, rgba(var(--color-primary-rgb), 0.04) 0%, transparent 45%);
  }

  :global([data-theme="dark"]) .process-section {
    background: radial-gradient(circle at 85% 75%, rgba(var(--color-secondary-rgb), 0.03) 0%, transparent 45%);
  }

  .process-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* --- 2. Section Header --- */
  .process-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .process-eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-2);
  }

  .process-heading {
    font-size: var(--text-2xl);
    color: var(--color-heading);
    margin-bottom: var(--space-3);
  }

  .process-subtext {
    font-size: var(--text-base);
    max-width: 65ch;
  }

  /* --- 3. Connected Steps Flow Container --- */
  .process-flow {
    position: relative;
    width: 100%;
  }

  .steps-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    position: relative;
    z-index: 1;
  }

  /* --- 4. Flow Connecting Line (Desktop vs Mobile) --- */
  .flow-line {
    position: absolute;
    background: repeating-linear-gradient(
      90deg, 
      var(--color-border), 
      var(--color-border) 6px, 
      transparent 6px, 
      transparent 12px
    );
    z-index: 0;
    pointer-events: none;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), background-color var(--transition-base);
  }

  /* Desktop connecting line: horizontal */
  .flow-line.desktop-only {
    display: none; /* Handled by media queries */
    top: 32px; /* Vertically centered with the 64px icon badges */
    left: 12.5%;
    width: 75%;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Mobile connecting line: vertical */
  .flow-line.mobile-only {
    display: block;
    top: 32px;
    bottom: 32px;
    left: 32px; /* Centered with the 64px vertical icon badges */
    width: 2px;
    height: auto;
    background: repeating-linear-gradient(
      0deg, 
      var(--color-border), 
      var(--color-border) 6px, 
      transparent 6px, 
      transparent 12px
    );
    transform: scaleY(0);
    transform-origin: top;
  }

  /* Trigger line drawing on scroll entry */
  .process-flow.animate .flow-line.desktop-only {
    transform: scaleX(1);
  }

  .process-flow.animate .flow-line.mobile-only {
    transform: scaleY(1);
  }

  /* --- 5. Individual Step Card Styling --- */
  .step-item {
    list-style: none;
    opacity: 0;
    transform: translateY(20px);
    /* Calculate delay dynamically based on step index */
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }

  /* Stagger delays in css transitions */
  .process-flow.animate .step-item {
    opacity: 1;
    transform: translateY(0);
  }
  
  .process-flow.animate .step-item:nth-child(1) { transition-delay: 200ms; }
  .process-flow.animate .step-item:nth-child(2) { transition-delay: 450ms; }
  .process-flow.animate .step-item:nth-child(3) { transition-delay: 700ms; }
  .process-flow.animate .step-item:nth-child(4) { transition-delay: 950ms; }

  .step-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    height: 100%;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base), border-color var(--transition-base);
  }

  .step-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-glow), var(--shadow-md);
    border-color: var(--color-secondary);
  }

  /* Header containing badge and watermark */
  .step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
    position: relative;
    width: 100%;
  }

  .step-icon-badge {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-base);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    z-index: 2; /* Sits above line */
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .step-card:hover .step-icon-badge {
    border-color: var(--color-secondary);
    box-shadow: 0 0 12px rgba(var(--color-secondary-rgb), 0.15);
  }

  .step-icon {
    transition: transform var(--transition-base);
  }

  .step-card:hover .step-icon {
    transform: rotate(5deg) scale(1.05);
  }

  /* Big background watermark number */
  .step-watermark {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: var(--weight-extrabold);
    color: rgba(var(--color-primary-rgb), 0.09); /* 9% opacity navy in light mode */
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    user-select: none;
    line-height: 1;
    z-index: 1;
    transition: color var(--transition-base), transform var(--transition-base);
  }

  :global([data-theme="dark"]) .step-watermark {
    color: rgba(var(--color-secondary-rgb), 0.06); /* 6% opacity gold in dark mode */
  }

  .step-card:hover .step-watermark {
    color: rgba(var(--color-secondary-rgb), 0.18);
    transform: translateY(-50%) scale(1.05);
  }

  .step-title {
    font-size: var(--text-md);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
    font-weight: var(--weight-bold);
  }

  .step-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
  }

  /* --- 6. Responsive Layout Breakpoints --- */
  
  /* Desktop overrides */
  @media (min-width: 768px) {
    .steps-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .steps-list {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }

    .flow-line.desktop-only {
      display: block;
    }

    .flow-line.mobile-only {
      display: none;
    }
  }

  /* Mobile vertical timeline alignment overrides */
  @media (max-width: 768px) {
    .process-header {
      align-items: center;
      text-align: center;
    }

    .step-item {
      padding-left: var(--space-12);
    }

    .step-header {
      justify-content: flex-start;
      margin-bottom: var(--space-4);
    }

    .step-icon-badge {
      position: absolute;
      left: -48px; /* Centers the icon container vertically over the left timeline line */
      width: 52px;
      height: 52px;
    }

    .flow-line.mobile-only {
      left: 26px; /* Aligns line directly behind centers of 52px icons */
    }

    .step-watermark {
      margin-left: auto;
    }
  }

  /* Reduced motion adaptations */
  @media (prefers-reduced-motion: reduce) {
    .flow-line {
      transform: none !important;
      transition: none;
    }
    .step-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .step-icon {
      transform: none !important;
    }
  }
</style>

<!-- Scroll Reveal Script -->
<script>
  const observeProcessFlow = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -100px 0px'
      }
    );

    const flowContainer = document.querySelector('.process-flow');
    if (flowContainer) {
      observer.observe(flowContainer);
    }

    const headerObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            headerObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05 }
    );
    
    document.querySelectorAll('.scroll-reveal').forEach((el) => {
      headerObserver.observe(el);
    });
  };

  const init = () => {
    requestAnimationFrame(() => {
      setTimeout(observeProcessFlow, 50);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:after-swap', init);
</script>
